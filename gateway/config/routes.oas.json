{
  "openapi": "3.1.0",
  "info": {
    "title": "FastFood Delivery — API Gateway",
    "version": "1.0.0",
    "description": "Entrada única do frontend. Roteia para o BFF, exige API key (Authorization: Bearer <chave>) e limita requisições por IP."
  },
  "paths": {
    "/aggregated-data": {
      "get": {
        "summary": "Dados agregados (MS Restaurantes + MS Pedidos + Function) (GET)",
        "operationId": "get-aggregated-data",
        "x-zuplo-route": {
          "corsPolicy": "anything-goes",
          "handler": {
            "export": "urlForwardHandler",
            "module": "$import(@zuplo/runtime)",
            "options": {
              "baseUrl": "${env.BFF_URL}"
            }
          },
          "policies": {
            "inbound": [
              "api-key-auth",
              "rate-limit"
            ]
          }
        }
      }
    },
