PORT=3002
# Connection string do Neon (Dashboard → Connect). Localmente: postgres://postgres:postgres@localhost:5432/pedidos
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Pagamento simulado: acima deste valor o pagamento é recusado
PAYMENT_LIMIT=500
PAYMENT_UNAVAILABLE=false
# Eventos (opcional): sem estas duas variáveis os eventos vão só para o log
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
EVENTS_DESTINATION_URL=https://SEU-PROJETO-FUNCTION.vercel.app/api/eventos
